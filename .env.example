# Local / Vite proxy (dev + preview on this machine).
VITE_API_BASE_URL=http://127.0.0.1:8001/api/v1

# Production (Vercel): set the same value as an Environment Variable in the
# Vercel project, or use frontend/.env.production. Must point at the Render API.
# VITE_API_BASE_URL=https://doctor-clinic-backend-h25x.onrender.com/api/v1

# Optional override for QR / shareable links (dev and preview).
# If unset, localhost is rewritten to https://<LAN-IP>:<current-port>.
# VITE_DEV_PUBLIC_URL=https://192.168.1.90:4173
